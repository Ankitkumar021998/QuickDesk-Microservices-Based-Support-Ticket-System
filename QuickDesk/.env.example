# Copy this file to .env before running: cp .env.example .env
# CHANGE ALL SECRETS before deploying anywhere public.

# Shared by auth-service (signs tokens) and ticket-service (verifies tokens)
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret for service-to-service calls (ticket-service -> auth-service)
INTERNAL_API_KEY=change-me-internal-key

# PostgreSQL (used only by auth-service)
POSTGRES_PASSWORD=change-me-db-password

# Admin account created automatically on first start of auth-service
ADMIN_NAME=QuickDesk Admin
ADMIN_EMAIL=admin@quickdesk.local
ADMIN_PASSWORD=Admin@12345
